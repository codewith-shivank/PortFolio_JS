rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'codewithshivank@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'displayName', 'email', 'role']) &&
        data.keys().hasOnly(['id', 'displayName', 'email', 'photoURL', 'role', 'createdAt', 'lastLoginAt']) &&
        data.id == request.auth.uid &&
        data.id is string && data.id.size() <= 128 &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 120 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.role in ['user', 'admin'] &&
        (data.role != 'admin' || (request.auth.token.email == 'codewithshivank@gmail.com' && request.auth.token.email_verified == true) || isAdmin());
    }

    // Validation for Inquiry
    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'subject', 'message', 'status', 'createdAt']) &&
        data.keys().hasOnly(['name', 'email', 'subject', 'message', 'userId', 'status', 'createdAt']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 120 &&
        data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200 &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 3000 &&
        data.status in ['unread', 'read', 'archived'] &&
        (!('userId' in data) || (data.userId is string && (!isSignedIn() || data.userId == request.auth.uid)));
    }

    // Validation for ProjectLike
    function isValidProjectLike(data) {
      return data.keys().hasAll(['projectId', 'userId', 'userName', 'createdAt']) &&
        data.keys().hasOnly(['projectId', 'userId', 'userName', 'createdAt']) &&
        data.projectId is string && data.projectId.size() > 0 && data.projectId.size() <= 64 &&
        data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100;
    }

    // Validation for GuestbookEntry
    function isValidGuestbook(data) {
      return data.keys().hasAll(['userId', 'userName', 'message', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'userName', 'userPhoto', 'userEmail', 'message', 'createdAt']) &&
        data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100 &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 1000 &&
        (!('userPhoto' in data) || (data.userPhoto is string && data.userPhoto.size() <= 500)) &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 120));
    }

    // Collection: users
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidUserProfile(incoming()) &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLoginAt', 'email']);
    }

    // Collection: inquiries
    match /inquiries/{inquiryId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming()) && incoming().status == 'unread';
      allow update: if isAdmin() && isValidId(inquiryId) && isValidInquiry(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin() && isValidId(inquiryId);
    }

    // Collection: projectLikes
    match /projectLikes/{likeId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(likeId) && isValidProjectLike(incoming());
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Collection: guestbook
    match /guestbook/{entryId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.auth.token.email_verified == true && isValidId(entryId) && isValidGuestbook(incoming());
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }
  }
}
